# انسخ هذا الملف إلى app/.env ثم املأ القيم. لا تضع أي سر في Git.
# المزود يجب أن يكون متوافقًا مع واجهة OpenAI (/chat/completions).

# مفتاح الـ API (إلزامي عند التشغيل بدون --resolve-only)
LLM_API_KEY=

# عنوان الـ API الأساسي (اختياري، الافتراضي أدناه)
LLM_BASE_URL=https://api.openai.com/v1

# اسم الموديل (إلزامي عند التشغيل بدون --resolve-only)
LLM_MODEL=

# مهلة طلب المزود بالملي ثانية (اختياري، الافتراضي 120000). عدد صحيح موجب.
LLM_TIMEOUT_MS=120000
